{
  "name": "writer-desktop",
  "productName": "Writer - 自动化写作软件",
  "version": "1.0.0",
  "description": "AI-assisted Chinese web novel writing desktop application",
  "main": "dist-electron/main.js",
  "author": "Writer Team",
  "license": "MIT",
  "scripts": {
    "build:electron": "npx tsc",
    "electron:dev": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:win_dir": "npm run build:electron && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.writer.app",
    "productName": "Writer",
    "directories": {
      "output": "release"
    },
    "files": [
      "frontend-build/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "resources/backend/**/*"
    ],
    "extraResources": [
      {
        "from": "../src/backend/.venv",
        "to": "python_venv",
        "filter": [
          "**/*",
          "!__pycache__{,/**}",
          "!**/*.pyc",
          "!**/*.pyo",
          "!_pytest{,/**}",
          "!*_test.py",
          "!.gitignore",
          "!.lock",
          "!.pth"
        ]
      },
      {
        "from": "../src/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.venv{,/**}",
          "!.omc{,/**}",
          "!__pycache__{,/**}",
          "!**/*.pyc",
          "!**/*.pyo",
          "!node_modules{,/**}",
          "!tests{,/**}",
          "!.env",
          "!.env.example",
          "!Dockerfile",
          "!*.md",
          "!cli.py",
          "!start.py",
          "!migrations.py",
          "!init_db.py"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "signingHashAlgorithms": [],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.2.0"
  }
}
