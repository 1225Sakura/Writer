{
  "name": "writer-desktop",
  "productName": "Writer - 自动化写作软件",
  "version": "1.0.0",
  "description": "AI-assisted Chinese web novel writing desktop application",
  "main": "dist-electron/main.js",
  "author": "Writer Team",
  "license": "MIT",
  "scripts": {
    "build:electron": "npx tsc",
    "electron:dev": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:win_dir": "npm run build:electron && electron-builder --win --dir",
    "dist:linux": "npm run build:electron && electron-builder --linux",
    "dist:mac": "npm run build:electron && electron-builder --mac"
  },
  "build": {
    "appId": "com.writer.app",
    "productName": "Writer",
    "directories": {
      "output": "release"
    },
    "files": [
      "frontend-build/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "asarUnpack": [],
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "signingHashAlgorithms": [],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-log": "^5.4.4",
    "typescript": "^5.7.2",
    "vite": "^6.2.0"
  }
}
