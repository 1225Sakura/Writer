# Auto Novel Writer - Git Attributes
* text=auto

# Python
*.py text eol=lf

# TypeScript/JavaScript
*.{ts,tsx,js,jsx} text eol=lf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Styles
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf

# SQL
*.sql text eol=lf

# Shell
*.sh text eol=lf

# Windows-specific - keep native line endings
*.bat text eol=crlf

# Binaries - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
